# ---- 构建与依赖（可随时重建）----
.venv/
build/
dist/
__pycache__/
*.pyc
.pytools/

# ---- 打包产物 ----
ClawBoard.exe
ClawBoardC/ClawBoardC.exe
ClawBoardC/*.obj
ClawBoardC/.vs/
ClawBoardC/*.vcxproj.user

# ---- 运行期数据 / 日志（含剪贴板隐私，绝不入库）----
ClawBoard数据.json
ClawBoard数据.json.bak
ClawBoard数据.json.tmp
crash.log
debug.log
*.log
导出_*
# 运行期图片缓存仅在数据目录（仓库根）下；docs/images/ 是仓库截图，必须入库，
# 所以这里用根锚定 `/images/` 而不是 `images/`（后者会误伤 docs/images/）。
/images/

# ---- 个人 / 课程材料（含身份信息，绝不开源）----
ClawBoard制作思路.docx
_make_docx.py
.workbuddy/

# ---- 内部工具与一次性脚本 ----
_archive/
_shot.py
_shot_narrow.py
_ui_shot.py

# ---- 临时产物 ----
_t*.out
_t2[0-1].out
_p*.txt
_p*.py
shot_*.png
ui_*.png
ClawBoardC/ClawBoardC_selftest.txt

# 发行产物（安装包 / 压缩包，由 packaging/ 脚本生成）
release/
